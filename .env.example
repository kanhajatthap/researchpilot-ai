# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# GEMINI_MODEL=gemini-3.6-flash
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Proactive embedding pacing (contents per minute). Unset/0 = adaptive pacing only.
# EMBEDDINGS_CONTENTS_PER_MINUTE=0
# Overall per-document processing timeout in ms. Default 300000 (5 minutes).
# DOCUMENT_PROCESSING_TIMEOUT_MS=300000

# Vector store (ChromaDB).
#
# Hosted (recommended for deployments) - Chroma Cloud. When CHROMA_API_KEY is
# set, the app connects to Chroma Cloud instead of a local server.
# CHROMA_API_KEY=your_chroma_cloud_api_key
# CHROMA_TENANT=your_tenant_id
# CHROMA_DATABASE=your_database
# CHROMA_HOST=api.trychroma.com
#
# Self-hosted / local dev (default when no API key is set):
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_URL=http://localhost:8000
# CHROMA_SSL=false

# Storage (local dev / tests use the filesystem by default).
#
# Managed storage (Vercel): Postgres for document + conversation state and
# Vercel Blob for uploaded PDFs. Selected automatically when both are present,
# or force it with STORAGE_DRIVER=vercel.
# STORAGE_DRIVER=vercel
# DATABASE_URL=postgres://user:password@host/db
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
#
# Local filesystem overrides (default paths shown):
# DOCUMENT_STORE_PATH=./data/documents
# CONVERSATION_STORE_PATH=./data/conversations
